{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "/home/shyuuhei/.config/fastfetch/cat.txt",
    "type": "file",
    "padding": {
      "top": 3
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────┐" // `` is `\033`, or `\e`
    },
    {
        "type": "os",
        "key": "    OS",
        "keyColor": "magenta"
    },
    {
      "key": "   󰌢 Machine",
      "keyColor": "magenta",
      "type": "host"
    },
    {
      "key": "    Kernel",
      "keyColor": "magenta",
      "type": "kernel"
    },
    {
      "key": "    Shell",
      "keyColor": "magenta",
      "type": "shell"
    },
    {
        "type": "packages",
        "key": "   󰏖 Packages",
        "keyColor": "magenta"
    },

    {
        "type": "uptime",
        "key": "    Uptime",
        "keyColor": "magenta"
    },
    {
        "type": "command",
        "key": "    OS Age",
        "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
        "keyColor": "magenta"
    },
    {
      "type": "localip",
      "key": "   󰩟 Local IP",
      "keyColor": "magenta",
      "compact": true
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────┘" // `` is `\033`, or `\e`
    }
  ]
}
